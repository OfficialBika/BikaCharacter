BOT_TOKEN=
MONGODB_URI=
DATABASE_NAME=bika_character_bot
OWNER_ID=
OWNER_USERNAME=@Official_Bika
BOT_USERNAME=

RUN_MODE=webhook
WEBHOOK_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET_TOKEN=
WEBHOOK_DROP_PENDING_UPDATES=true
PORT=10000

CARD_DATABASE_CHANNEL_ID=
GROUP_LOG_CHANNEL_ID=
ADDER_GROUP_IDS=-1003983636133

# Render traffic / hot-cache tuning
SQLITE_HOT_PATH=data/hot_cache.db
SQLITE_FLUSH_SECONDS=10
SQLITE_REFRESH_SECONDS=30
SQLITE_BUSY_TIMEOUT_MS=5000
DROP_SPAWN_LOCK_SECONDS=45
DROP_IGNORE_OLD_MESSAGES_SECONDS=0

# Telegram traffic
BOT_ALLOWED_UPDATES=message,callback_query,inline_query,my_chat_member
ENABLE_HEALTH_SERVER=false

# Captcha media
CAPTCHA_IMAGE_FORMAT=jpeg
CAPTCHA_IMAGE_WIDTH=960
CAPTCHA_IMAGE_HEIGHT=480
CAPTCHA_JPEG_QUALITY=74

DEFAULT_CHANGETIME=100
CLAIM_DAILY_LIMIT=25
CLAIM_TIMEZONE=Asia/Yangon
CLAIM_CAPTCHA_SECONDS=120

# Inline search
INLINE_PAGE_SIZE=50
INLINE_CACHE_TIME=60

# Profile
PROFILE_TABLE=false

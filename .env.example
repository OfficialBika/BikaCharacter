# BIKA Character Bot environment
BOT_TOKEN=
MONGODB_URI=
OWNER_ID=
BOT_USERNAME=

# Rarity names (change only if you intentionally want different DB labels)
RARITY_COMMON_NAME=Common
RARITY_UNCOMMON_NAME=Uncommon
RARITY_RARE_NAME=Rare
RARITY_LEGENDARY_NAME=Legendary
RARITY_MYSTICAL_NAME=Mystical
RARITY_DIVINE_NAME=Divine
RARITY_CROSSVERSE_NAME=CrossVerse
RARITY_CATAPHRACT_NAME=Cataphract
RARITY_SUPREME_NAME=Supreme
LIMITED_RARITY_NAME=Limited

# Telegram custom emoji IDs — one unique ID per rarity.
# Paste the numeric custom emoji ID from Telegram.
# When an ID is empty, the matching fallback Unicode emoji is used.
RARITY_LIMITED_CUSTOM_EMOJI_ID=
RARITY_COMMON_CUSTOM_EMOJI_ID=
RARITY_UNCOMMON_CUSTOM_EMOJI_ID=
RARITY_RARE_CUSTOM_EMOJI_ID=
RARITY_LEGENDARY_CUSTOM_EMOJI_ID=
RARITY_MYSTICAL_CUSTOM_EMOJI_ID=
RARITY_DIVINE_CUSTOM_EMOJI_ID=
RARITY_CROSSVERSE_CUSTOM_EMOJI_ID=
RARITY_CATAPHRACT_CUSTOM_EMOJI_ID=
RARITY_SUPREME_CUSTOM_EMOJI_ID=

# Fallbacks are only used when the corresponding custom emoji ID is unavailable.
RARITY_LIMITED_FALLBACK_EMOJI=🔮
RARITY_COMMON_FALLBACK_EMOJI=🔵
RARITY_UNCOMMON_FALLBACK_EMOJI=🟣
RARITY_RARE_FALLBACK_EMOJI=🟠
RARITY_LEGENDARY_FALLBACK_EMOJI=🟡
RARITY_MYSTICAL_FALLBACK_EMOJI=💮
RARITY_DIVINE_FALLBACK_EMOJI=⚜️
RARITY_CROSSVERSE_FALLBACK_EMOJI=⚡
RARITY_CATAPHRACT_FALLBACK_EMOJI=✨
RARITY_SUPREME_FALLBACK_EMOJI=🪞

# Legacy compatibility:
# LIMITED_CUSTOM_EMOJI_ID=...
# LIMITED_FALLBACK_EMOJI=...
# Existing deployments may keep these; RARITY_* keys take precedence.

# Button / Telegram UI custom emoji support
ENABLE_BUTTON_CUSTOM_EMOJI=true
ENABLE_BUTTON_STYLE=true
